# Copy to tools/autopost/.env (gitignored) and fill in. The same names are the GitHub Actions secrets.

# Cloudflare R2: one API token with Object Read & Write on both buckets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=tappstudio-reels
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
R2_STATE_BUCKET=tappstudio-autopost

# Instagram: one long-lived token per account (Meta app > Instagram > API setup with Instagram login)
IG_TOKEN_MISBAHA=
IG_TOKEN_NASAB=
IG_TOKEN_SPLITUP=
IG_TOKEN_KADAK=

# YouTube: Desktop OAuth client from Google Cloud; yt_auth.py fills in the refresh token
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Until the YouTube API audit passes, Google forces uploads to private anyway
YT_PRIVACY=public
